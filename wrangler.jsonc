// Cloudflare Workers static assets for the Internal Learning site (library + courses).
// Cloudflare runs `python3 build.py` (build command), then `npx wrangler deploy`,
// which uploads ./dist as static assets. No Worker script is needed.
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "activities",
  "compatibility_date": "2025-09-01",
  // Serve on activities.<account>.workers.dev until a custom domain is attached
  "workers_dev": true,
  // Workers Logs, kept and searchable in the dashboard
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    // /<course>/ch/<slug>/ serves its index.html; unknown paths get 404.html; _redirects keeps old links working
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
