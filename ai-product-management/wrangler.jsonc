// Cloudflare Workers static assets for the AI Product Management course.
// Cloudflare runs `python3 build.py` (build command), then `npx wrangler deploy`,
// which uploads ./dist as static assets. No Worker script is needed.
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "activities",
  "compatibility_date": "2025-09-01",
  // Serve on activities.<account>.workers.dev until a custom domain is attached
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // /ch/<slug>/ serves /ch/<slug>/index.html; unknown paths get 404.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
